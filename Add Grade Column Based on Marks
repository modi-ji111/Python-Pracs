import pandas as pd

data = {
    "Name": ["Rahul", "Amit", "Priya", "Sneha"],
    "Marks": [85, 72, 90, 65]
}

df = pd.DataFrame(data)

def grade(marks):
    if marks >= 80:
        return "A"
    elif marks >= 70:
        return "B"
    else:
        return "C"

df["Grade"] = df["Marks"].apply(grade)

print(df)
